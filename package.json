{
  "name": "monica-keepass-extension",
  "version": "0.1.1",
  "description": "Monica KeePass browser extension: Windows Hello unlock, autofill, password generation, OneDrive backup",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "crx": "node scripts/build-crx.mjs",
    "compile": "tsc --noEmit",
    "test:smoke": "node scripts/smoke.mjs",
    "test:harness": "esbuild scripts/harness.ts --bundle --platform=node --format=cjs --tsconfig=tsconfig.json --outfile=node_modules/.cache/harness.cjs && node node_modules/.cache/harness.cjs",
    "postinstall": "wxt prepare"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/chrome": "^0.1.42",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.3",
    "wxt": "^0.20.26"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-slider": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tabler/icons-react": "^3.44.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hash-wasm": "^4.12.0",
    "kdbxweb": "^2.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.3.0",
    "tldts": "^7.4.0"
  }
}
